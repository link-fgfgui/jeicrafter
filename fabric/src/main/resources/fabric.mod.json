{
    "schemaVersion": 1,
    "id": "mod_id",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "${license}",
    "icon": "assets/jeicrafter/${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.jeicrafter.JeiCrafter"
        ],
        "client": [
            "com.jeicrafter.fabric.client.JeiCrafterClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "jei": "${jei_version_range_fabric}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  